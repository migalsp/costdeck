# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only what the builds need. Later lines win.
**

# Go sources
!cmd/**
!api/**
!internal/**
!go.mod
!go.sum
**/*_test.go

# Whatever `make ui` synced locally; the image builds the dashboard in its own stage.
internal/api/ui/*
!internal/api/ui/.gitkeep

# Dashboard sources
!ui/**
ui/node_modules
ui/dist

# Prebuilt binary for Dockerfile.local
!manager
