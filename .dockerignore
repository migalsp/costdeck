# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files
!**/*.go
!cmd/**
!api/**
!internal/**
!go.mod
!go.sum
**/*_test.go

# Re-include UI source files
!ui/**
ui/node_modules

# Re-include API and Internal directories
!api/**
!internal/**

# Hack and Config for boilerplate and other needs
!hack/**
!config/**
!PROJECT
!Dockerfile
!manager
